{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppt2wiki:office-change:1.0.0",
  "title": "Office ChangeSet v1",
  "description": "Snapshot-bound semantic observations for Office documents. This is not an executable patch or a complete document representation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "format", "documents", "comparison", "coverage", "changes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "format": { "enum": ["docx", "xlsx", "pptx"] },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/document" },
        "after": { "$ref": "#/$defs/document" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "aspects"],
      "properties": {
        "profile": { "const": "office-semantic-v1" },
        "aspects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/aspect" }
        },
        "geometryToleranceEmu": { "type": "integer", "minimum": 0, "default": 0 },
        "compareCachedFormulaValues": { "type": "boolean", "default": false }
      }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "part": { "type": "string", "pattern": "^/[^?#\\s\\\\]+$" },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "name"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "aspect": {
      "enum": ["existence", "text", "value", "formula", "style", "geometry", "order", "parent", "media", "metadata"]
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation", "aspect", "target", "property", "before", "after"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["add", "remove", "update", "move"] },
        "aspect": { "$ref": "#/$defs/aspect" },
        "target": { "$ref": "#/$defs/target" },
        "property": {
          "type": "string",
          "description": "RFC 6901 pointer into the target's canonical semantic object, not the source XML or the Change envelope.",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "before": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/state" }] },
        "after": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/state" }] },
        "match": { "$ref": "#/$defs/match" },
        "groupId": { "$ref": "#/$defs/id" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "add" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "aspect": { "const": "existence" }, "property": { "const": "" },
              "before": { "type": "null" }, "after": { "$ref": "#/$defs/objectState" }
            },
            "not": { "required": ["match"] }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "remove" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "aspect": { "const": "existence" }, "property": { "const": "" },
              "before": { "$ref": "#/$defs/objectState" }, "after": { "type": "null" }
            },
            "not": { "required": ["match"] }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "update" } }, "required": ["operation"] },
          "then": {
            "required": ["match"],
            "properties": {
              "aspect": { "enum": ["text", "value", "formula", "style", "geometry", "media", "metadata"] },
              "property": { "minLength": 1 },
              "before": { "$ref": "#/$defs/state" }, "after": { "$ref": "#/$defs/state" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "move" } }, "required": ["operation"] },
          "then": {
            "required": ["match"],
            "properties": {
              "aspect": { "enum": ["order", "parent"] }, "property": { "const": "/placement" },
              "before": { "$ref": "#/$defs/placementState" }, "after": { "$ref": "#/$defs/placementState" }
            }
          }
        },
        {
          "if": { "properties": { "aspect": { "const": "text" } }, "required": ["aspect"] },
          "then": {
            "properties": {
              "property": { "const": "/text" },
              "before": { "$ref": "#/$defs/textState" }, "after": { "$ref": "#/$defs/textState" }
            }
          }
        },
        {
          "if": { "properties": { "aspect": { "const": "formula" } }, "required": ["aspect"] },
          "then": {
            "properties": {
              "property": { "const": "/formula" },
              "before": { "$ref": "#/$defs/formulaState" }, "after": { "$ref": "#/$defs/formulaState" }
            }
          }
        },
        {
          "if": { "properties": { "aspect": { "const": "value" } }, "required": ["aspect"] },
          "then": {
            "properties": {
              "property": { "const": "/value" },
              "before": { "$ref": "#/$defs/scalarState" }, "after": { "$ref": "#/$defs/scalarState" }
            }
          }
        },
        {
          "if": { "properties": { "aspect": { "const": "style" } }, "required": ["aspect"] },
          "then": { "properties": { "property": { "pattern": "^/style(?:/|$)" } } }
        },
        {
          "if": { "properties": { "aspect": { "const": "geometry" } }, "required": ["aspect"] },
          "then": {
            "properties": {
              "property": { "const": "/geometry" },
              "before": { "$ref": "#/$defs/geometryState" }, "after": { "$ref": "#/$defs/geometryState" }
            }
          }
        },
        {
          "if": { "properties": { "aspect": { "const": "media" } }, "required": ["aspect"] },
          "then": {
            "properties": {
              "property": { "const": "/asset" },
              "before": { "$ref": "#/$defs/assetState" }, "after": { "$ref": "#/$defs/assetState" }
            }
          }
        },
        {
          "if": { "properties": { "aspect": { "const": "metadata" } }, "required": ["aspect"] },
          "then": { "properties": { "property": { "pattern": "^/metadata(?:/|$)" } } }
        }
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "kind", "label"],
      "properties": {
        "entityId": { "$ref": "#/$defs/id", "description": "Identity scoped to this ChangeSet; native shape IDs and cell addresses are not entity IDs." },
        "kind": { "enum": ["document", "section", "paragraph", "textRange", "table", "row", "column", "cell", "sheet", "slide", "shape", "group", "image", "chart", "note", "other"] },
        "label": { "type": "string", "minLength": 1 },
        "subtype": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "$ref": "#/$defs/value" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "textState": {
      "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "properties": { "type": { "const": "text" } } } } }]
    },
    "formulaState": {
      "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "properties": { "type": { "enum": ["text", "null"] } } } } }]
    },
    "scalarState": {
      "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "properties": { "type": { "enum": ["text", "number", "boolean", "null", "error"] } } } } }]
    },
    "objectState": {
      "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "properties": { "type": { "const": "object" } } } } }]
    },
    "assetState": {
      "allOf": [{ "$ref": "#/$defs/state" }, { "properties": { "value": { "properties": { "type": { "const": "asset" } } } } }]
    },
    "geometryState": {
      "allOf": [
        { "$ref": "#/$defs/objectState" },
        { "properties": { "value": { "properties": { "data": { "$ref": "#/$defs/geometry" } } } } }
      ]
    },
    "placementState": {
      "allOf": [
        { "$ref": "#/$defs/objectState" },
        { "properties": { "value": { "properties": { "data": { "$ref": "#/$defs/placement" } } } } }
      ]
    },
    "value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "data"],
      "properties": {
        "type": { "enum": ["text", "number", "boolean", "null", "error", "object", "array", "asset"] },
        "data": true
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["text", "error"] } } }, "then": { "properties": { "data": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "data": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$" } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "data": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "null" } } }, "then": { "properties": { "data": { "type": "null" } } } },
        { "if": { "properties": { "type": { "const": "object" } } }, "then": { "properties": { "data": { "type": "object" } } } },
        { "if": { "properties": { "type": { "const": "array" } } }, "then": { "properties": { "data": { "type": "array" } } } },
        { "if": { "properties": { "type": { "const": "asset" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/asset" } } } }
      ]
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "space", "x", "y", "width", "height", "rotation", "flipH", "flipV"],
      "properties": {
        "unit": { "const": "emu" },
        "space": { "enum": ["slide", "parent", "inline"] },
        "x": { "type": ["integer", "null"] }, "y": { "type": ["integer", "null"] },
        "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 },
        "rotation": { "type": "integer", "description": "OOXML angle units: 60000 per degree." },
        "flipH": { "type": "boolean" }, "flipV": { "type": "boolean" },
        "childFrame": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer" }, "y": { "type": "integer" },
            "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "space": { "const": "inline" } } },
          "then": { "properties": { "x": { "type": "null" }, "y": { "type": "null" } } },
          "else": { "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } } }
        }
      ]
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["parentEntityId", "index"],
      "properties": {
        "parentEntityId": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "mediaType", "part"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1 },
        "part": { "$ref": "#/$defs/part" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["part", "locator"],
      "properties": {
        "part": { "$ref": "#/$defs/part" },
        "locator": {
          "oneOf": [
            { "$ref": "#/$defs/wordLocator" }, { "$ref": "#/$defs/excelLocator" },
            { "$ref": "#/$defs/pptLocator" }, { "$ref": "#/$defs/xmlLocator" }
          ]
        }
      }
    },
    "elementPath": {
      "type": "array", "items": { "type": "integer", "minimum": 0 },
      "description": "Zero-based element-child indices from the part's XML document element; [] identifies that root. Excludes text nodes and comments. Snapshot-local."
    },
    "textRange": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "length", "unit"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "unit": { "const": "utf16" }
      }
    },
    "wordLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "elementPath"],
      "properties": {
        "type": { "const": "word" }, "elementPath": { "$ref": "#/$defs/elementPath" },
        "paragraphId": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}$" },
        "range": { "$ref": "#/$defs/textRange" }
      }
    },
    "excelLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["sheetId"] }, { "required": ["elementPath"] }],
      "properties": {
        "type": { "const": "excel" },
        "sheetId": { "type": "integer", "minimum": 1 },
        "address": { "type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$" },
        "row": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "elementPath": { "$ref": "#/$defs/elementPath" }
      },
      "dependentRequired": { "address": ["sheetId"], "row": ["sheetId"], "column": ["sheetId"] }
    },
    "pptLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["slideId"] }, { "required": ["elementPath"] }],
      "properties": {
        "type": { "const": "powerpoint" },
        "slideId": { "type": "integer", "minimum": 1 },
        "shapePath": {
          "type": "array", "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "description": "Native cNvPr IDs from outer group to target shape in this snapshot."
        },
        "cell": {
          "type": "object", "additionalProperties": false, "required": ["row", "column"],
          "properties": {
            "row": { "type": "integer", "minimum": 0 }, "column": { "type": "integer", "minimum": 0 }
          }
        },
        "range": { "$ref": "#/$defs/textRange" },
        "elementPath": { "$ref": "#/$defs/elementPath" }
      },
      "dependentRequired": { "shapePath": ["slideId"], "cell": ["shapePath"], "range": ["shapePath"] }
    },
    "xmlLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "elementPath"],
      "properties": { "type": { "const": "xml" }, "elementPath": { "$ref": "#/$defs/elementPath" } }
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "confidence", "evidence"],
      "properties": {
        "method": { "enum": ["nativeId", "structure", "content", "composite", "manual"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/coverageIssue" } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "complete" } } }, "then": { "properties": { "issues": { "maxItems": 0 } } } },
        { "if": { "properties": { "status": { "const": "partial" } } }, "then": { "properties": { "issues": { "minItems": 1 } } } }
      ]
    },
    "coverageIssue": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "side", "message"],
      "properties": {
        "code": { "enum": ["unsupportedFeature", "opaqueContent", "unresolvedStyle", "ambiguousMatch", "unresolvedAnchor", "truncatedContent"] },
        "side": { "enum": ["before", "after", "both"] },
        "message": { "type": "string", "minLength": 1 },
        "aspect": { "$ref": "#/$defs/aspect" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$" },
      "additionalProperties": true,
      "description": "Namespaced optional metadata, such as ppt2wiki.review. Must not override core semantics."
    }
  }
}
