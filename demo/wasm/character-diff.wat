;; Standalone bidirectional Myers search. Inputs are uint32 grapheme IDs.
;; No imports, managed runtime, C/C# compiler, or WASI environment.
(module
  (memory (export "memory") 2 2048)
  (func $get (param $p i32) (param $i i32) (result i32)
    (i32.load (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2)))))
  (func $set (param $p i32) (param $i i32) (param $v i32)
    (i32.store (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))) (local.get $v)))
  (func $pack (param $x i32) (param $y i32) (result i64)
    (i64.or (i64.shl (i64.extend_i32_u (local.get $x)) (i64.const 32)) (i64.extend_i32_u (local.get $y))))
  (func (export "bisect") (param $a i32) (param $n i32) (param $b i32) (param $m i32)
    (param $vf i32) (param $vr i32) (result i64)
    (local $max i32) (local $offset i32) (local $len i32) (local $i i32)
    (local $delta i32) (local $odd i32) (local $d i32) (local $phase i32)
    (local $fs i32) (local $fe i32) (local $rs i32) (local $re i32)
    (local $v i32) (local $otherV i32) (local $k i32) (local $end i32)
    (local $idx i32) (local $x i32) (local $y i32) (local $other i32)
    (local $ai i32) (local $bi i32) (local $work i32)
    (local.set $max (i32.div_u (i32.add (i32.add (local.get $n) (local.get $m)) (i32.const 1)) (i32.const 2)))
    (local.set $offset (i32.add (local.get $max) (i32.const 1)))
    (local.set $len (i32.add (i32.mul (local.get $max) (i32.const 2)) (i32.const 3)))
    (loop $init
      (call $set (local.get $vf) (local.get $i) (i32.const -1))
      (call $set (local.get $vr) (local.get $i) (i32.const -1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $init (i32.lt_u (local.get $i) (local.get $len))))
    (call $set (local.get $vf) (i32.add (local.get $offset) (i32.const 1)) (i32.const 0))
    (call $set (local.get $vr) (i32.add (local.get $offset) (i32.const 1)) (i32.const 0))
    (local.set $delta (i32.sub (local.get $n) (local.get $m)))
    (local.set $odd (i32.and (local.get $delta) (i32.const 1)))
    (loop $distance
      (local.set $phase (i32.const 0))
      (loop $phases
        (if (i32.eqz (local.get $phase))
          (then
            (local.set $v (local.get $vf)) (local.set $otherV (local.get $vr))
            (local.set $k (i32.sub (local.get $fs) (local.get $d)))
            (local.set $end (i32.sub (local.get $d) (local.get $fe))))
          (else
            (local.set $v (local.get $vr)) (local.set $otherV (local.get $vf))
            (local.set $k (i32.sub (local.get $rs) (local.get $d)))
            (local.set $end (i32.sub (local.get $d) (local.get $re)))))
        (block $diagonalsDone
          (loop $diagonals
            (br_if $diagonalsDone (i32.gt_s (local.get $k) (local.get $end)))
            (local.set $work (i32.add (local.get $work) (i32.const 1)))
            (if (i32.gt_u (local.get $work) (i32.const 20000000)) (then (return (i64.const -2))))
            (local.set $idx (i32.add (local.get $offset) (local.get $k)))
            (if (i32.or
                (i32.eq (local.get $k) (i32.sub (i32.const 0) (local.get $d)))
                (i32.and (i32.ne (local.get $k) (local.get $d))
                  (i32.lt_s (call $get (local.get $v) (i32.sub (local.get $idx) (i32.const 1)))
                            (call $get (local.get $v) (i32.add (local.get $idx) (i32.const 1))))))
              (then (local.set $x (call $get (local.get $v) (i32.add (local.get $idx) (i32.const 1)))))
              (else (local.set $x (i32.add (call $get (local.get $v) (i32.sub (local.get $idx) (i32.const 1))) (i32.const 1)))))
            (local.set $y (i32.sub (local.get $x) (local.get $k)))
            (block $snakeDone
              (loop $snake
                (br_if $snakeDone (i32.or (i32.ge_u (local.get $x) (local.get $n)) (i32.ge_u (local.get $y) (local.get $m))))
                (local.set $ai (if (result i32) (local.get $phase)
                  (then (i32.sub (i32.sub (local.get $n) (local.get $x)) (i32.const 1))) (else (local.get $x))))
                (local.set $bi (if (result i32) (local.get $phase)
                  (then (i32.sub (i32.sub (local.get $m) (local.get $y)) (i32.const 1))) (else (local.get $y))))
                (br_if $snakeDone (i32.ne (call $get (local.get $a) (local.get $ai)) (call $get (local.get $b) (local.get $bi))))
                (local.set $x (i32.add (local.get $x) (i32.const 1)))
                (local.set $y (i32.add (local.get $y) (i32.const 1)))
                (br $snake)))
            (call $set (local.get $v) (local.get $idx) (local.get $x))
            (if (i32.gt_s (local.get $x) (local.get $n))
              (then (if (local.get $phase) (then (local.set $re (i32.add (local.get $re) (i32.const 2)))) (else (local.set $fe (i32.add (local.get $fe) (i32.const 2))))))
              (else (if (i32.gt_s (local.get $y) (local.get $m))
                (then (if (local.get $phase) (then (local.set $rs (i32.add (local.get $rs) (i32.const 2)))) (else (local.set $fs (i32.add (local.get $fs) (i32.const 2))))))
                (else (if (i32.ne (local.get $odd) (local.get $phase))
                  (then
                    (local.set $other (i32.add (local.get $offset) (i32.sub (local.get $delta) (local.get $k))))
                    (if (i32.lt_u (local.get $other) (local.get $len))
                      (then
                        (local.set $i (call $get (local.get $otherV) (local.get $other)))
                        (if (i32.and (i32.ge_s (local.get $i) (i32.const 0)) (i32.ge_s (i32.add (local.get $x) (local.get $i)) (local.get $n)))
                          (then
                            (if (local.get $phase)
                              (then (return (call $pack (local.get $i) (i32.sub (local.get $i) (i32.sub (local.get $delta) (local.get $k))))))
                              (else (return (call $pack (local.get $x) (local.get $y)))))))))))))))
            (local.set $k (i32.add (local.get $k) (i32.const 2)))
            (br $diagonals)))
        (local.set $phase (i32.add (local.get $phase) (i32.const 1)))
        (br_if $phases (i32.lt_u (local.get $phase) (i32.const 2))))
      (local.set $d (i32.add (local.get $d) (i32.const 1)))
      (br_if $distance (i32.le_u (local.get $d) (local.get $max))))
    (i64.const -1))
)
