{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppt2wiki:office-text-diff:1",
  "title": "ppt2wiki.textDiff extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit", "granularity", "beforeLength", "afterLength", "edits"],
  "properties": {
    "unit": { "const": "utf16" },
    "granularity": { "const": "grapheme" },
    "beforeLength": { "type": "integer", "minimum": 0 },
    "afterLength": { "type": "integer", "minimum": 0 },
    "edits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edit" } }
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "length", "text"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" }
      }
    },
    "edit": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "before", "after"],
      "properties": {
        "operation": { "enum": ["insert", "delete", "replace"] },
        "before": { "$ref": "#/$defs/span" },
        "after": { "$ref": "#/$defs/span" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "insert" } } },
          "then": { "properties": { "before": { "properties": { "length": { "const": 0 }, "text": { "const": "" } } }, "after": { "properties": { "length": { "minimum": 1 } } } } }
        },
        {
          "if": { "properties": { "operation": { "const": "delete" } } },
          "then": { "properties": { "before": { "properties": { "length": { "minimum": 1 } } }, "after": { "properties": { "length": { "const": 0 }, "text": { "const": "" } } } } }
        },
        {
          "if": { "properties": { "operation": { "const": "replace" } } },
          "then": { "properties": { "before": { "properties": { "length": { "minimum": 1 } } }, "after": { "properties": { "length": { "minimum": 1 } } } } }
        }
      ]
    }
  }
}
